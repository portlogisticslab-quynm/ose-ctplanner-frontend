# Build-time API endpoints for Cloudflare Pages (committed: no secrets here).
# VITE_API_HOME = Worker "ose-failover" (VPS first, home server read-only after it).
# VITE_API_RENDER = home server read-only backup, used only when the Worker cannot be reached (layer 2).
# VITE_API_DIRECT = VPS straight (no Worker): long requests (replay, reports, imports, DXF, file runs) - V1.4.2.
VITE_API_HOME=https://api-ctplanner.ose.vn
VITE_API_RENDER=https://api-ctplanner-home.ose.vn
VITE_API_DIRECT=https://api-ctplanner-vps.ose.vn
